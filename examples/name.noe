# 이름과 바이트
#
# 문자열 변수는 없으므로 입력을 격자에 바이트로 담습니다.
# emitc는 값을 바이트로, emitn은 값을 숫자로 출력합니다.
# 줄바꿈의 코드는 10입니다.
fermion n
fermion i
fermion c
fermion text[64] @ 8192

emit "이름을 입력하세요: "
|c> <- absorbc
while <c|~1024 != 10
 if <c|~256 < 0
    |c> <- 10
 else
    |text[<n|~256]> <- <c|~256
    raise n
    |c> <- absorbc

emit "안녕하세요, "
while <i|~256 < <n|~256
 emitc <text[<i|~256]|~1024
 raise i
emit "님!\n"

emit "입력은 "
emitn <n|~256
emit "바이트입니다:"
|i> <- 0
while <i|~256 < <n|~256
 emit " "
 emitn <text[<i|~256]|~1024
 raise i
emit "\n"
