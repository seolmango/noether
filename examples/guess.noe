# 숫자 맞히기
#
# 난수 함수는 없지만 날카로운 읽기는 값을 흔듭니다.
# 비밀 숫자를 일부러 여러 번 날카롭게 읽어서 섞습니다.
# 게임이 길어지면 타일이 달아올라 비밀 숫자가 흔들릴 수 있습니다.
field seed=random

fermion secret
fermion guess
fermion n
fermion tries

|n> <- 12
|secret> <- 50
while <n|~1024 > 0
 |guess> <- <secret|
 lower n

while <secret|~128 < 1
 raise secret
while <secret|~128 > 100
 lower secret

|guess> <- 0
while <guess|~128 != <secret|~128
 emit "1~100 사이 숫자 (0이면 포기): "
 |guess> <- absorb
 raise tries
 if <guess|~128 == 0
    emit "포기했습니다. 비밀 숫자는 "
    emitn <secret|~128
    emit "이었습니다. 아마도요.\n"
    |tries> <- 0
    |guess> <- <secret|~128
 if <guess|~128 < <secret|~128
    emit "더 큰 수입니다.\n"
 if <guess|~128 > <secret|~128
    emit "더 작은 수입니다.\n"

if <tries|~128 > 0
 emit "정답! "
 emitn <tries|~128
 emit "번 만에 맞혔습니다.\n"
