# 구구단
#
# 곱셈 연산자가 없어서 겹침과 제곱으로 곱합니다.
# ab = ((a+b)^2 - (a-b)^2) / 4
field seed=1

fermion dan

path mul(a, b)
 boson p @ a
 fermion s @ 8192
 boson u @ s
 |p> <- <b|~64
 |s> <- <a|a>~64
 flip p
 |u> <- <a|a>~64
 flip u
 return <s+768|~1024

path table(d)
 fermion i
 |i> <- 1
 while <i|~64 <= 9
    emitn <d|~64
    emit " x "
    emitn <i|~64
    emit " = "
    emit mul(<d|~64, <i|~64)
    raise i

emit "몇 단을 볼까요? (2~9, 0이면 전부): "
|dan> <- absorb

if <dan|~1024 == 0
 |dan> <- 2
 while <dan|~1024 <= 9
    table(<dan|~1024)
    emit "\n"
    raise dan
else
 table(<dan|~1024)
