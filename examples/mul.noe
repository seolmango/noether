# Multiplication by interference: ab = ((a+b)^2 - (a-b)^2) / 4
field seed=1

path mul(a, b)
 boson p @ a               # overlaps a
 fermion s
 boson u @ s               # overlaps s
 |p> <- <b|~32             # the spot of a now reads a+b
 |s> <- <a|a>~32           # (a+b)^2
 flip p                    # the spot of a now reads a-b
 |u> <- <a|a>~32           # (a-b)^2
 flip u                    # the spot of s now reads 4ab
 return <s+768|~1024       # off-centre read: weight 256/1024 = 1/4

emit mul(6, 7)
emit mul(-12, 12)
emit mul(123456, 789)
