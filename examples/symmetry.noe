# Both symmetries. Temperature must not change inside "symmetry time".
field seed=4

fermion a[4] @ 0 stride 4096
boson   b[4] @ a stride 4096     # b[k] overlaps a[k]
fermion c[4] @ 65536 stride 4096
boson   acc @ 131072
boson   one @ 131072

|a[0]> <- 1
|a[1]> <- 2
|a[2]> <- 3
|a[3]> <- 4
|b[0]> <- 10
|b[1]> <- 20
|b[2]> <- 30
|b[3]> <- 40
symmetry translate k in a
 |c[k]> <- <a[k]|~32               # vector add by overlap
emit <c[0]|~32
emit <c[3]|~32
|one> <- 5
symmetry time
 fuse acc one                      # reversible add, no heat
 fuse acc one
 raise acc
emit <acc|~32
