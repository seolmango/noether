# Bubble sort over a lattice, indices held in fermions
field seed=3

fermion a[8] @ 0 stride 4096
fermion i @ 40960
fermion j @ 45056
fermion t @ 49152
boson   jn @ 53248
fermion n @ 57344

|a[0]> <- 5
|a[1]> <- 3
|a[2]> <- 9
|a[3]> <- 1
|a[4]> <- 7
|a[5]> <- 2
|a[6]> <- 8
|a[7]> <- 4
|i> <- 7
while <i|~32 > 0
 |j> <- 0
 while <j|~32 < <i|~32
    |jn> <- <j|~32
    raise jn
    if <a[<j|~32]|~32 > <a[<jn|~32]|~32
         swap a[<j|~32] a[<jn|~32]
    raise j
 lower i
|i> <- 0
while <i|~32 < 8
 emit <a[<i|~32]|~32
 raise i
