# 슈뢰딩거의 고양이
#
# 고양이와 독약은 같은 타일, 즉 같은 상자에 있습니다.
# 독약을 덮어쓸수록 상자가 뜨거워지고, 임계 온도를
# 넘으면 들여다볼 때마다 고양이의 값이 흔들립니다.
# 흔든 횟수를 바꿔 보면서 온도 그래프를 보세요.
field tau=1024 seed=11

fermion cat @ 0
fermion poison @ 2048
fermion shakes @ 8192
fermion seen @ 12288

emit "상자를 몇 번 흔들까요? (10, 100, 1000): "
|shakes> <- absorb
|cat> <- 1

while <shakes|~32 > 0
 |poison> <- -1
 |poison> <- 0
 |seen> <- <cat|~32
 lower shakes

|seen> <- <cat|~32

emit "관측값: "
emit <seen|~32
if <seen|~32 > 0
 emit "야옹! 고양이는 살아 있습니다.\n"
else
 emit "고양이는 죽었습니다.\n"
