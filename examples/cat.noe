# 슈뢰딩거의 고양이
#
# 상자 안의 원자가 붕괴하면 독이 퍼져 고양이가 죽습니다.
# 원자의 값은 아직 아무도 정하지 않았습니다.
# 날카로운 읽기가 그 값을 무작위로 정하고, 정해진 값은
# 변수에 남습니다. 그래서 상자를 여는 순간 운명이 갈리고,
# 그 뒤로는 몇 번을 봐도 같습니다.
field seed=random

fermion atom
fermion cat
fermion scratch
fermion look

|cat> <- 1

emit "상자가 닫혀 있습니다. 고양이의 운명은 아직 정해지지 않았습니다.\n"
emit "Enter를 누르면 상자를 엽니다: "
|scratch> <- absorb

# 단 한 번의 관측이 원자의 값을 정한다
if <atom| > 0
 |cat> <- 0

if <cat|~32 > 0
 emit "야옹! 고양이는 살아 있습니다.\n"
else
 emit "원자가 붕괴했습니다. 고양이는 죽었습니다.\n"

emit "원자를 다시 들여다봅니다:"
|look> <- 3
while <look|~32 > 0
 emit " "
 emitn <atom|~32
 lower look
emit "\n한 번 정해진 값은 바뀌지 않습니다.\n"
