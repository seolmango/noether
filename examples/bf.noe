# Noether로 쓴 Brainfuck 인터프리터. 튜링 완전성의 증거입니다.
# 입력: 프로그램, '!' 바이트, 프로그램의 입력.
#
# 자주 읽는 변수는 한 타일에 모아 서로 따뜻하게 유지하고,
# 깊은 반복은 함수로 빼서 마찰 열을 줄입니다.
# 드문드문 읽는 격자는 ~1024로 읽습니다.
field seed=5

fermion pc @ 0
fermion dp @ 512
fermion n  @ 1024
fermion ch @ 1536
fermion depth @ 2048
fermion heater @ 2560
fermion code[512] @ 8192 stride 2048
fermion tape[256] @ 4194304 stride 2048

path forward()
 |depth> <- 1
 while <depth|~64 > 0
    raise pc
    |ch> <- <code[<pc|~64]|~1024
    if <ch|~64 == 91
         raise depth
    if <ch|~64 == 93
         lower depth

path backward()
 |depth> <- 1
 while <depth|~64 > 0
    lower pc
    |ch> <- <code[<pc|~64]|~1024
    if <ch|~64 == 93
         raise depth
    if <ch|~64 == 91
         lower depth

path step()
 |ch> <- <code[<pc|~64]|~1024
 if <ch|~64 == 43
    raise tape[<dp|~64]
 if <ch|~64 == 45
    lower tape[<dp|~64]
 if <ch|~64 == 62
    raise dp
 if <ch|~64 == 60
    lower dp
 if <ch|~64 == 46
    emitc <tape[<dp|~64]|~1024
 if <ch|~64 == 44
    |tape[<dp|~64]> <- absorbc
 if <ch|~64 == 91
    if <tape[<dp|~64]|~1024 == 0
         forward()
 if <ch|~64 == 93
    if <tape[<dp|~64]|~1024 != 0
         backward()
 raise pc

|heater> <- -1
|heater> <- 0
|heater> <- -1
|heater> <- 0
|ch> <- absorbc
while <ch|~64 != 33
 if <ch|~64 < 0
    |ch> <- 33
 else
    |code[<n|~64]> <- <ch|~64
    raise n
    |ch> <- absorbc

while <pc|~64 < <n|~64
 step()
