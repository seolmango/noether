# Noether로 쓴 Brainfuck 인터프리터.
# 입력: 프로그램, '!' 바이트, 프로그램의 입력.
#
# 전역 변수는 얕은 곳에서만 읽고, 깊은 곳의 일은 전부 함수로 넘깁니다.
# 분기 판단의 열은 함수가 끝나면 사라집니다.
# 이전 버전은 제곱수를 9까지 세고 사망했습니다.
field seed=5

fermion pc @ 0
fermion dp @ 512
fermion n  @ 1024
fermion code[4096] @ 8192 stride 2048
fermion tape[4096] @ 16777216 stride 2048

path at(p)
 return <code[<p|~64]|~1024

path forward(p)
 fermion depth
 fermion c
 |depth> <- 1
 while <depth|~64 > 0
    raise p
    |c> <- at(<p|~64)
    if <c|~64 == 91
         raise depth
    if <c|~64 == 93
         lower depth
 return <p|~64

path backward(p)
 fermion depth
 fermion c
 |depth> <- 1
 while <depth|~64 > 0
    lower p
    |c> <- at(<p|~64)
    if <c|~64 == 93
         raise depth
    if <c|~64 == 91
         lower depth
 return <p|~64

path step(c, d, p)
 if <c|~64 == 43
    raise tape[<d|~64]
 if <c|~64 == 45
    lower tape[<d|~64]
 if <c|~64 == 62
    raise dp
 if <c|~64 == 60
    lower dp
 if <c|~64 == 46
    emitc <tape[<d|~64]|~1024
 if <c|~64 == 44
    |tape[<d|~64]> <- absorbc
 if <c|~64 == 91
    if <tape[<d|~64]|~1024 == 0
         return forward(<p|~64)
 if <c|~64 == 93
    if <tape[<d|~64]|~1024 != 0
         return backward(<p|~64)
 return <p|~64

path put(c)
 |code[<n|~256]> <- <c|~64
 raise n

path load()
 fermion ch
 |ch> <- absorbc
 while <ch|~64 != 33
    if <ch|~64 < 0
         |ch> <- 33
    else
         put(<ch|~64)
         |ch> <- absorbc

load()

while <pc|~256 < <n|~256
 |pc> <- step(at(<pc|~256), <dp|~256, <pc|~256)
 raise pc
