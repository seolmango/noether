# 재귀. 호출마다 따뜻한 메모리가 새로 생긴다.
field seed=2

path mul(a, b)
 boson p @ a
 fermion s @ 8192
 boson u @ s
 |p> <- <b|~64
 |s> <- <a|a>~64
 flip p
 |u> <- <a|a>~64
 flip u
 return <s+768|~1024

path fact(n)
 if <n|~64 <= 1
    return 1
 fermion m
 |m> <- <n|~64
 lower m
 return mul(<n|~64, fact(<m|~64))

emit fact(10)
emit fact(15)
